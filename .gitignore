# ────────────────────────────────────────────────
# Astro / Node.js – .gitignore
# ────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
.output/
.vercel/
.netlify/

# Astro internal cache & type-gen
.astro/

# Environment variables
.env
.env.*
!.env.example
!.env.sample

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor & IDE
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user
*.sublime-workspace

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS temp files
Thumbs.db
Desktop.ini
ehthumbs.db

# Test coverage
coverage/
.nyc_output/

# Optional: lock files (chọn 1 trong 2, giữ nguyên nếu dùng npm)
# yarn.lock
# pnpm-lock.yaml

---
import { switchLangUrl, type Lang } from '../lib/i18n';

interface Props {
  currentLang?: Lang;
  currentPath?: string;
}

const { currentLang = 'vi', currentPath = '/' } = Astro.props;

const viUrl = switchLangUrl(currentPath, 'vi');
const enUrl = switchLangUrl(currentPath, 'en');
---

<div class="relative inline-flex items-center p-1 rounded-full zen-glass border border-zen-border/70 text-xs font-semibold select-none">
  <!-- VI Option -->
  <a
    href={viUrl}
    data-lang="vi"
    class={`flex items-center gap-1.5 px-3 py-1 rounded-full transition-all duration-300 ${
      currentLang === 'vi'
        ? 'bg-zen-emerald text-zen-bg font-bold shadow-sm shadow-zen-emerald/30'
        : 'text-zen-muted hover:text-zen-cream'
    }`}
    title="Tiếng Việt"
    aria-label="Tiếng Việt"
  >
    <span>VI</span>
  </a>

  <!-- EN Option -->
  <a
    href={enUrl}
    data-lang="en"
    class={`flex items-center gap-1.5 px-3 py-1 rounded-full transition-all duration-300 ${
      currentLang === 'en'
        ? 'bg-zen-emerald text-zen-bg font-bold shadow-sm shadow-zen-emerald/30'
        : 'text-zen-muted hover:text-zen-cream'
    }`}
    title="English"
    aria-label="English"
  >
    <span>EN</span>
  </a>
</div>

<script>
  function setupLangSwitchers() {
    document.querySelectorAll('[data-lang]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang');
        if (lang) {
          localStorage.setItem('preferred_lang', lang);
        }
      });
    });
  }

  setupLangSwitchers();
  document.addEventListener('astro:page-load', setupLangSwitchers);
</script>

---
interface Props {
  youtubeId?: string;
  tiktokUrl?: string;
  readingTime?: string;
}
const { youtubeId, tiktokUrl, readingTime = '4 phút lắng dịu' } = Astro.props;
---

<div class="my-8 p-4 rounded-2xl zen-glass border border-white/10 flex flex-wrap items-center justify-between gap-4">
  <div class="flex items-center gap-3 text-xs font-semibold text-zen-muted">
    <span class="flex items-center gap-1.5 text-zen-emerald">
      <span>🍃</span>
      <span>{readingTime}</span>
    </span>
    <span>•</span>
    <span>3 Cách Tiếp Nhận</span>
  </div>

  <div class="flex items-center gap-2">
    <!-- Nút Đọc Văn Bản -->
    <button
      class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-zen-sage/20 text-zen-emerald border border-zen-sage/40 flex items-center gap-1.5 transition-all"
    >
      <span>📖</span>
      <span>Đọc bài</span>
    </button>

    <!-- Nút Nghe YouTube / Podcast -->
    {youtubeId ? (
      <a
        href={`https://www.youtube.com/watch?v=${youtubeId}`}
        target="_blank"
        rel="noopener noreferrer"
        class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white/5 text-zen-muted hover:text-red-300 hover:bg-red-500/10 border border-white/10 hover:border-red-500/30 flex items-center gap-1.5 transition-all"
      >
        <span>🎧</span>
        <span>Nghe Podcast</span>
      </a>
    ) : (
      <a
        href="/media#youtube"
        class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white/5 text-zen-muted hover:text-red-300 hover:bg-red-500/10 border border-white/10 hover:border-red-500/30 flex items-center gap-1.5 transition-all"
      >
        <span>🎧</span>
        <span>Nghe Podcast</span>
      </a>
    )}

    <!-- Nút Xem TikTok 60s -->
    {tiktokUrl ? (
      <a
        href={tiktokUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white/5 text-zen-muted hover:text-cyan-300 hover:bg-cyan-500/10 border border-white/10 hover:border-cyan-500/30 flex items-center gap-1.5 transition-all"
      >
        <span>📱</span>
        <span>Video 60s</span>
      </a>
    ) : (
      <a
        href="/media#tiktok"
        class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white/5 text-zen-muted hover:text-cyan-300 hover:bg-cyan-500/10 border border-white/10 hover:border-cyan-500/30 flex items-center gap-1.5 transition-all"
      >
        <span>📱</span>
        <span>Video 60s</span>
      </a>
    )}
  </div>
</div>

---
import { getCollection } from 'astro:content';

const allEntries = await getCollection('endogenism');
const searchDatabase = allEntries.map(entry => ({
  title: entry.data.title,
  slug: entry.id === 'index' ? '/' : `/${entry.id}`,
  body: entry.body ? entry.body.substring(0, 1000) : '', // index first 1000 chars to keep search DB size small
}));
---

<div class="relative">
  <!-- Search Trigger Button -->
  <button
    id="search-trigger"
    class="p-2 rounded-lg hover:bg-muted text-muted-foreground hover:text-accent transition-colors flex items-center gap-1.5"
    title="Search (Cmd+K)"
    aria-label="Search"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.3-4.3"></path>
    </svg>
    <span class="hidden md:inline text-xs bg-muted border border-border px-1.5 py-0.5 rounded font-sans text-muted-foreground/80">⌘K</span>
  </button>

  <!-- Search Modal Backdrop -->
  <div
    id="search-backdrop"
    class="fixed inset-0 bg-background/80 backdrop-blur-sm z-50 hidden transition-opacity duration-200 opacity-0"
  >
    <!-- Search Modal Content -->
    <div class="fixed inset-x-4 top-20 max-w-2xl mx-auto bg-card border border-border rounded-xl shadow-2xl overflow-hidden flex flex-col max-h-[70vh] transition-transform duration-200 translate-y-4">
      <!-- Search Header -->
      <div class="flex items-center gap-3 px-4 py-3 border-b border-border">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-muted-foreground"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          type="text"
          id="search-input"
          placeholder="Tìm kiếm bài viết..."
          class="w-full bg-transparent border-0 focus:outline-none focus:ring-0 text-foreground placeholder:text-muted-foreground/60 text-base"
        />
        <button
          id="search-close"
          class="p-1 rounded hover:bg-muted text-muted-foreground hover:text-foreground text-sm"
        >
          ESC
        </button>
      </div>

      <!-- Search Results -->
      <div id="search-results" class="flex-1 overflow-y-auto p-4 space-y-2 divide-y divide-border/30">
        <div class="text-center py-8 text-sm text-muted-foreground">
          Nhập từ khóa để bắt đầu tìm kiếm...
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Embed Search Database -->
<script define:vars={{ searchDatabase }}>
  window.searchDatabase = searchDatabase;
</script>

<script>
  let isSearchOpen = false;

  const toggleSearch = (show: boolean) => {
    const backdrop = document.getElementById('search-backdrop');
    const modal = backdrop?.firstElementChild;
    const input = document.getElementById('search-input') as HTMLInputElement | null;

    if (!backdrop || !modal) return;

    if (show) {
      isSearchOpen = true;
      backdrop.classList.remove('hidden');
      // Force layout reflow for animation
      void backdrop.offsetHeight;
      backdrop.classList.remove('opacity-0');
      modal.classList.remove('translate-y-4');
      input?.focus();
      document.body.classList.add('overflow-hidden');
    } else {
      isSearchOpen = false;
      backdrop.classList.add('opacity-0');
      modal.classList.add('translate-y-4');
      setTimeout(() => {
        if (!isSearchOpen) {
          backdrop.classList.add('hidden');
          document.body.classList.remove('overflow-hidden');
        }
      }, 200);
    }
  };

  const setupSearch = () => {
    const trigger = document.getElementById('search-trigger');
    const backdrop = document.getElementById('search-backdrop');
    const closeBtn = document.getElementById('search-close');
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const resultsContainer = document.getElementById('search-results');

    trigger?.addEventListener('click', () => toggleSearch(true));
    closeBtn?.addEventListener('click', () => toggleSearch(false));

    backdrop?.addEventListener('click', (e) => {
      if (e.target === backdrop) {
        toggleSearch(false);
      }
    });

    // Keyboard Shortcuts
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        toggleSearch(true);
      }
      if (e.key === 'Escape' && isSearchOpen) {
        e.preventDefault();
        toggleSearch(false);
      }
    });

    // Simple search matching logic
    input?.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      if (!resultsContainer) return;

      if (!query) {
        resultsContainer.innerHTML = `
          <div class="text-center py-8 text-sm text-muted-foreground">
            Nhập từ khóa để bắt đầu tìm kiếm...
          </div>
        `;
        return;
      }

      // Search matching logic: match query in title or body
      // @ts-ignore
      const db = window.searchDatabase || [];
      const results = db.filter((item: any) => 
        item.title.toLowerCase().includes(query) || 
        item.body.toLowerCase().includes(query)
      );

      if (results.length === 0) {
        resultsContainer.innerHTML = `
          <div class="text-center py-8 text-sm text-muted-foreground">
            Không tìm thấy kết quả phù hợp cho "${query}"
          </div>
        `;
        return;
      }

      resultsContainer.innerHTML = results.map((res: any) => {
        // Find match position in body for excerpt
        const index = res.body.toLowerCase().indexOf(query);
        let excerpt = '';
        if (index !== -1) {
          const start = Math.max(0, index - 40);
          const end = Math.min(res.body.length, index + query.length + 80);
          excerpt = '...' + res.body.substring(start, end).replace(/\n/g, ' ') + '...';
        } else {
          excerpt = res.body.substring(0, 100).replace(/\n/g, ' ') + '...';
        }

        return `
          <a href="${res.slug}" class="block p-3 rounded-lg hover:bg-muted transition-colors text-left group">
            <h4 class="font-semibold text-sm text-foreground group-hover:text-accent flex items-center gap-1.5 transition-colors">
              <span>🌱</span> ${res.title}
            </h4>
            <p class="text-xs text-muted-foreground mt-1 font-sans line-clamp-2 leading-relaxed">${excerpt}</p>
          </a>
        `;
      }).join('');
    });
  };

  setupSearch();
  document.addEventListener('astro:after-swap', setupSearch);
</script>

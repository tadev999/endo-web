---
import { getT, type Lang } from '../lib/i18n';
import { getMachList } from '../lib/journey';

interface Props {
  lang?: Lang;
}

const { lang = 'vi' } = Astro.props;
const t = getT(lang);
const machList = getMachList(lang);

const homeUrl = lang === 'en' ? '/en' : '/';
const aboutUrl = lang === 'en' ? '/en/noi-sinh' : '/noi-sinh';
const tocUrl = lang === 'en' ? '/en/posts' : '/posts';
const mediaUrl = lang === 'en' ? '/en/media' : '/media';
const machBaseUrl = lang === 'en' ? '/en/mach' : '/mach';
---

<footer class="relative z-10 border-t border-zen-border/60 bg-zen-void/80 backdrop-blur-xl mt-32">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      <!-- Cột 1: Giới thiệu & Triết lý -->
      <div class="md:col-span-2 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-zen-sage to-zen-emerald flex items-center justify-center text-white text-sm">
            🌸
          </div>
          <span class="font-bold text-lg text-zen-cream">endogenism</span>
        </div>
        <p class="text-sm text-zen-muted leading-relaxed max-w-md">
          {t.footerDesc}
        </p>
        <div class="italic text-xs text-zen-subtle border-l-2 border-zen-sage/40 pl-3 py-1 mt-2">
          {t.footerQuote}
        </div>
      </div>

      <!-- Cột 2: 5 Mạch Tư Tưởng -->
      <div>
        <h4 class="text-xs font-bold text-zen-cream tracking-wider uppercase mb-4">{t.footerMachTitle}</h4>
        <ul class="space-y-2.5 text-sm text-zen-muted">
          {machList.map((m) => (
            <li>
              <a href={`${machBaseUrl}/${m.id}`} class="hover:text-zen-emerald transition-colors">
                {t.machPrefix} {m.n}: {m.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Cột 3: Hệ Sinh Thái & Đa Nền Tảng -->
      <div>
        <h4 class="text-xs font-bold text-zen-cream tracking-wider uppercase mb-4">{t.footerEcosystem}</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="https://anam.app" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-zen-emerald hover:underline font-medium">
              <span>🌸</span>
              <span>Anam — App Thực Hành</span>
            </a>
          </li>
          <li>
            <a href={`${mediaUrl}#youtube`} class="flex items-center gap-2 text-zen-muted hover:text-zen-cream transition-colors">
              <svg class="w-4 h-4 text-red-400" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              <span>YouTube Video & Podcast</span>
            </a>
          </li>
          <li>
            <a href={`${mediaUrl}#tiktok`} class="flex items-center gap-2 text-zen-muted hover:text-zen-cream transition-colors">
              <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
              </svg>
              <span>TikTok Micro-Wisdom</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Tầng bản quyền & Tri ân -->
    <div class="border-t border-zen-border/40 pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-zen-subtle gap-4">
      <div>
        {t.footerCopyright}
      </div>
      <div class="flex items-center gap-6">
        <a href={homeUrl} class="hover:text-zen-muted transition-colors">{t.backToHome}</a>
        <a href={aboutUrl} class="hover:text-zen-muted transition-colors">{t.navAbout}</a>
        <a href={tocUrl} class="hover:text-zen-muted transition-colors">{t.backToToc}</a>
        <a href="https://anam.app" target="_blank" rel="noopener noreferrer" class="hover:text-zen-muted transition-colors">Anam App</a>
      </div>
    </div>
  </div>
</footer>

---
import { getMachList, getJourney, slugOf, machOf } from '../lib/journey';
import { getT, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'vi' } = Astro.props;
const t = getT(lang);
const machList = getMachList(lang);

const posts = await getJourney(lang);
const idsByMach = Object.fromEntries(
  machList.map((m) => [m.id, posts.filter((p) => machOf(p.id, lang)?.id === m.id && p.id.includes('/bai-')).map(slugOf)])
);

const machBaseUrl = lang === 'en' ? '/en/mach' : '/mach';
---

<div id="hanh-trinh" class="scroll-mt-28">
  <div class="text-center max-w-xl mx-auto mb-10">
    <span class="zen-chip text-zen-emerald bg-zen-emerald/10 border border-zen-emerald/20 mb-4">
      {lang === 'en' ? 'The 5 Streams' : 'Hành trình 150 bài'}
    </span>
    <h2 class="text-2xl sm:text-3xl font-serif text-zen-cream tracking-tight">
      {lang === 'en' ? 'Five stages, each with a core question' : 'Năm chặng, mỗi chặng một câu hỏi'}
    </h2>
    <p class="text-sm text-zen-muted mt-3 leading-relaxed">
      {lang === 'en'
        ? 'No need to read strictly in sequence. If you are unsure where to begin — let whatever question stirs you lead the way.'
        : 'Không cần đọc theo thứ tự. Nhưng nếu bạn chưa biết bắt đầu từ đâu — hãy để câu hỏi nào đang chạm vào mình dẫn đường.'}
    </p>
  </div>

  <ol class="relative max-w-2xl mx-auto">
    <!-- sợi chỉ nối 5 chặng -->
    <div class="absolute left-[27px] top-6 bottom-6 w-px bg-gradient-to-b from-mach-1 via-mach-3 to-mach-5 opacity-30" aria-hidden="true"></div>

    {machList.map((m) => (
      <li class="relative pl-20 pb-6 last:pb-0">
        <span
          class="absolute left-0 top-1 w-14 h-14 rounded-full flex items-center justify-center text-2xl zen-glass"
          style={`border-color:${m.color}55;box-shadow:0 0 24px -6px ${m.color}`}
        >
          {m.icon}
        </span>

        <a href={`${machBaseUrl}/${m.id}`} class="block zen-glass-card rounded-[1.75rem] p-5 sm:p-6 group">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] uppercase tracking-[0.18em] font-semibold mb-2">
            <span style={`color:${m.color}`}>{t.machPrefix} {m.n} · {m.stage}</span>
            <span class="text-zen-subtle normal-case tracking-normal font-normal">{m.range}</span>
            <span
              class="mach-read text-zen-subtle normal-case tracking-normal font-normal ml-auto"
              data-ids={(idsByMach[m.id] || []).join(',')}
              data-lang={lang}
            ></span>
          </div>
          <h3 class="text-lg font-semibold text-zen-cream group-hover:text-white">{m.title}</h3>
          <p class="mt-2 font-serif italic text-zen-cream/80 leading-snug">“{m.question}”</p>
          <p class="mt-2 text-xs text-zen-muted leading-relaxed">{m.desc}</p>
        </a>
      </li>
    ))}
  </ol>
</div>

<script>
  import { getRead } from '../lib/progress';

  const read = getRead();
  document.querySelectorAll<HTMLElement>('.mach-read').forEach((el) => {
    const ids = (el.dataset.ids || '').split(',').filter(Boolean);
    const lang = el.dataset.lang || 'vi';
    const done = ids.filter((id) => read.has(id)).length;
    if (done) {
      el.textContent = lang === 'en' ? `Read ${done}/${ids.length}` : `Đã đọc ${done}/${ids.length}`;
    }
  });
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import DailyPebble from '../components/DailyPebble.astro';
import MoodSelector from '../components/MoodSelector.astro';
import FiveArteriesJourney from '../components/FiveArteriesJourney.astro';
import AnamPracticeBridge from '../components/AnamPracticeBridge.astro';
import { UI } from '../lib/i18n';

const twoValues = UI.vi.twoValues;
const phrases = UI.vi.phrases;
---

<BaseLayout lang="vi" currentPath="/">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 relative">

    <!-- HERO: câu tuyên ngôn cốt lõi -->
    <section class="min-h-[78vh] flex flex-col items-center justify-center text-center pt-10 pb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs text-zen-muted zen-glass mb-10">
        <span class="w-1.5 h-1.5 rounded-full bg-zen-emerald animate-pulse"></span>
        <span id="circadianBadge">Chào bạn</span>
      </div>

      <h1 class="text-[2rem] !leading-[1.2] sm:text-5xl lg:text-6xl font-serif text-zen-cream tracking-tight max-w-3xl mb-6 animate-fade-in">
        Thứ bạn đang tìm kiếm không nằm ở phía trước bạn.
        <span class="block italic text-zen-emerald mt-3">Nó đã có trong bạn — đang chờ được tin vào.</span>
      </h1>

      <p class="text-sm sm:text-base text-zen-muted max-w-xl leading-relaxed mb-10">
        150 bài viết chậm rãi cho những ai đang mệt vì phải chứng minh mình đủ tốt. Không thuyết giảng, không công thức — chỉ những câu hỏi để hỏi cùng nhau.
      </p>

      <div class="flex flex-col sm:flex-row items-center gap-3">
        <a
          id="heroStart"
          href="/posts/mach-1-goi-ten/bai-001"
          class="pebble-press inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-sm font-semibold bg-zen-emerald text-zen-bg hover:bg-zen-mint shadow-lg shadow-zen-emerald/20"
        >
          <span id="heroStartLabel">Bắt đầu từ Bài 1</span>
          <span aria-hidden="true">→</span>
        </a>
        <a href="/noi-sinh" class="pebble-press text-sm font-medium text-zen-muted hover:text-zen-cream py-3.5 px-5 rounded-full border border-white/10 hover:border-white/20">
          Nội Sinh là gì?
        </a>
      </div>
      <p id="heroLast" class="hidden mt-4 text-xs text-zen-subtle max-w-md line-clamp-1"></p>
    </section>

    <!-- BÀI CỦA HÔM NAY -->
    <section class="zen-reveal mb-20">
      <DailyPebble lang="vi" />
    </section>

    <!-- HAI LOẠI GIÁ TRỊ -->
    <section class="zen-reveal my-20">
      <div class="text-center max-w-xl mx-auto mb-10">
        <span class="zen-chip text-zen-gold bg-zen-gold/10 border border-zen-gold/20 mb-4">Điểm khởi đầu</span>
        <h2 class="text-2xl sm:text-3xl font-serif text-zen-cream tracking-tight">Hai loại giá trị</h2>
        <p class="text-sm text-zen-muted mt-3 leading-relaxed">
          Thành tích, kỹ năng, sự phát triển đều có giá trị. Nhưng chúng là <em class="text-zen-cream">biểu hiện</em> của giá trị — không phải <em class="text-zen-cream">nguồn gốc</em> của nó.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {twoValues.map((v, i) => (
          <div class={`rounded-[1.75rem] p-6 sm:p-7 ${i === 1 ? 'zen-stream-pod border-zen-emerald/25' : 'zen-glass'}`}>
            <h3 class={`text-lg font-serif mb-4 ${v.tone}`}>{v.name}</h3>
            <ul class="space-y-3">
              {v.lines.map((l) => (
                <li class={`flex gap-3 text-sm leading-relaxed ${i === 1 ? 'text-zen-cream/90' : 'text-zen-muted'}`}>
                  <span class={i === 1 ? 'text-zen-emerald' : 'text-zen-subtle'}>{i === 1 ? '●' : '○'}</span>
                  <span>{l}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="text-center font-serif italic text-zen-cream/80 mt-8">
        Endogenism không dạy bạn ngừng phát triển. Nó thay đổi <span class="text-zen-emerald">nơi bạn đứng</span> khi phát triển.
      </p>
    </section>

    <div class="zen-mist-divider"></div>

    <!-- 5 MẠCH -->
    <section class="zen-reveal my-20">
      <FiveArteriesJourney lang="vi" />
      <div class="text-center mt-10">
        <a href="/posts" class="text-sm font-semibold text-zen-muted hover:text-zen-cream">Xem mục lục đủ 150 bài →</a>
      </div>
    </section>

    <div class="zen-mist-divider"></div>

    <!-- LỐI VÀO THEO TÂM TRẠNG -->
    <section class="zen-reveal my-20">
      <MoodSelector />
    </section>

    <!-- NGÔN NGỮ CỦA GÓC NHÌN -->
    <section class="zen-reveal my-20 text-center">
      <p class="text-[11px] uppercase tracking-[0.2em] text-zen-subtle mb-5">Những câu bạn sẽ gặp lại nhiều lần</p>
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-3 max-w-2xl mx-auto">
        {phrases.map((p, i) => (
          <span class={`font-serif italic text-lg sm:text-xl ${i % 2 ? 'text-zen-cream/60' : 'text-zen-cream/90'}`}>“{p}”</span>
        ))}
      </div>
    </section>

    <!-- CẦU NỐI SANG ANAM -->
    <section class="zen-reveal my-20 pb-12">
      <AnamPracticeBridge lang="vi" />
    </section>
  </div>
</BaseLayout>

<script>
  import { getLast } from '../lib/progress';

  const hour = new Date().getHours();
  const badge = document.getElementById('circadianBadge');
  if (badge) {
    badge.textContent =
      hour >= 5 && hour < 11 ? 'Chào buổi sáng — không cần vội'
      : hour < 17 && hour >= 11 ? 'Giữa ngày, một nhịp thở chậm'
      : hour < 22 && hour >= 17 ? 'Buổi tối an lành'
      : 'Đêm đã khuya — bạn vẫn ở đây';
  }

  const last = getLast();
  if (last) {
    const start = document.getElementById('heroStart') as HTMLAnchorElement | null;
    const label = document.getElementById('heroStartLabel');
    const hint = document.getElementById('heroLast');
    if (start && label) {
      start.href = `/posts/${last.id}`;
      label.textContent = 'Đọc tiếp hành trình';
    }
    if (hint) {
      hint.textContent = `Lần trước: ${last.title}`;
      hint.classList.remove('hidden');
    }
  }
</script>
